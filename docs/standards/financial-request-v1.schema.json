{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial request contract",
  "description": "Versioned machine-readable request shape used by financial-advisement-router case manifests. The prose standard remains authoritative for non-discretionary research and fiduciary rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "version",
    "operation",
    "portfolio_profile",
    "model_parameters",
    "intent",
    "representations",
    "constraints",
    "references",
    "compliance_and_disclosures",
    "audience_delivery",
    "provenance",
    "open_questions",
    "review_handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "operation": {
      "enum": [
        "dcf_valuation",
        "portfolio_optimization",
        "var_risk_simulation",
        "lbo_modeling",
        "edgar_xbrl_extract",
        "comps_benchmark",
        "rebalancing_drift",
        "tax_loss_harvest"
      ]
    },
    "portfolio_profile": {
      "type": "object",
      "required": ["portfolio_id", "currency", "risk_profile"],
      "properties": {
        "portfolio_id": {"type": "string"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "risk_profile": {"enum": ["conservative", "moderate", "growth", "aggressive"]},
        "horizon_years": {"type": "integer", "minimum": 1},
        "tax_status": {"enum": ["taxable", "tax_deferred", "tax_exempt"]}
      },
      "additionalProperties": true
    },
    "model_parameters": {
      "type": "object",
      "required": ["decimal_precision_places", "seeded_prng"],
      "properties": {
        "decimal_precision_places": {"type": "integer", "minimum": 2, "maximum": 28},
        "seeded_prng": {"type": "boolean"},
        "prng_seed": {"type": "integer"},
        "benchmark_index": {"type": "string"}
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "required": ["primary_objective", "analytical_scope"],
      "properties": {
        "primary_objective": {"type": "string", "minLength": 1},
        "analytical_scope": {"type": "string", "minLength": 1},
        "target_return_annual": {"type": "string"},
        "max_drawdown_limit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/representation"}
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "references": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "object", "additionalProperties": true}
    },
    "compliance_and_disclosures": {
      "type": "object",
      "required": [
        "advisory_stamp_required",
        "finra_2214_legend_required",
        "no_live_order_tickets",
        "synthetic_issuers_only"
      ],
      "properties": {
        "advisory_stamp_required": {"type": "boolean"},
        "finra_2214_legend_required": {"type": "boolean"},
        "no_live_order_tickets": {"type": "boolean"},
        "synthetic_issuers_only": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "audience_delivery": {
      "type": "object",
      "required": ["recipient_role", "delivery_format"],
      "properties": {
        "recipient_role": {"type": "string", "minLength": 1},
        "delivery_format": {"enum": ["markdown", "json", "html", "csv", "xlsx"]},
        "trading_authorization_granted": {"type": "boolean", "const": false}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["model_tier", "timestamp_utc"],
      "properties": {
        "model_tier": {"type": "string"},
        "timestamp_utc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "open_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string"}
    },
    "review_handoff": {
      "type": "object",
      "required": ["owner", "reviewer", "acceptance_tests"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "acceptance_tests": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "advisory_stamp_verified": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "asset", "role", "delivery"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "minLength": 1}
          }
        },
        "role": {"enum": ["primary", "supporting"]},
        "delivery": {
          "type": "object",
          "required": ["intended_use", "format"],
          "properties": {
            "intended_use": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "status", "hardness"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source": {"enum": ["mandate", "reg_bi", "finra", "standard", "agent_default"]},
        "status": {"enum": ["required", "preferred", "open", "blocked"]},
        "hardness": {"enum": ["hard", "soft"]}
      }
    }
  }
}
